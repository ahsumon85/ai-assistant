# Database
DATABASE_URL=postgresql+psycopg://jobflow:jobflow@localhost:5432/jobflow
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEFAULT_ADMIN_EMAIL=admin@jobflow.example
DEFAULT_ADMIN_PASSWORD=admin123

# CORS / Frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# LLM — groq (free hosted), ollama (local), or openai
# Get a free Groq key at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
# For faster local runs, prefer an instruct model: qwen3:8b-instruct or llama3.2:3b
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
OLLAMA_THINK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Matching
MATCH_THRESHOLD=70

# Inbound email (IMAP) — fetch job alerts
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.email@gmail.com
IMAP_PASSWORD=your-app-password
# For syncing ALL LinkedIn emails (read + unread), use Gmail All Mail:
# IMAP_FOLDER="[Gmail]/All Mail"
# Or for LinkedIn in Gmail Social tab: IMAP_FOLDER="[Gmail]/Social"
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true
IMAP_MARK_READ=true
IMAP_FETCH_LIMIT=50
IMAP_JOB_SENDERS=linkedin.com,indeed.com,notifications.linkedin.com,mail.indeed.com
IMAP_SUBJECT_KEYWORDS=job,alert,opening,position,hire,recruit

# Outbound email (send applications)
EMAIL_PROVIDER=dry_run
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:8000/api/integrations/outlook/callback

# Webhook secrets
GREENHOUSE_WEBHOOK_SECRET=
LEVER_WEBHOOK_SECRET=
INGEST_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT=100/minute
